INITIALIZATION
CREATE TABLE JP_T1(ID INT, V INT);
SUCCESS
CREATE TABLE JP_T2(ID INT, V INT);
SUCCESS
CREATE TABLE JP_T3(ID INT, V INT);
SUCCESS
CREATE TABLE JP_EMPTY(ID INT, V INT);
SUCCESS

DATA
INSERT INTO JP_T1 VALUES (1, 10);
SUCCESS
INSERT INTO JP_T1 VALUES (1, 11);
SUCCESS
INSERT INTO JP_T1 VALUES (2, 20);
SUCCESS
INSERT INTO JP_T1 VALUES (3, 30);
SUCCESS

INSERT INTO JP_T2 VALUES (1, 100);
SUCCESS
INSERT INTO JP_T2 VALUES (1, 101);
SUCCESS
INSERT INTO JP_T2 VALUES (2, 200);
SUCCESS
INSERT INTO JP_T2 VALUES (4, 400);
SUCCESS

INSERT INTO JP_T3 VALUES (1, 1000);
SUCCESS
INSERT INTO JP_T3 VALUES (3, 3000);
SUCCESS

1. CARTESIAN JOIN (MUST BE NLJ)
ENSURE:NLJ SELECT * FROM JP_T1, JP_T2;
SELECT * FROM JP_T1, JP_T2;
1 | 10 | 1 | 100
1 | 10 | 1 | 101
1 | 10 | 2 | 200
1 | 10 | 4 | 400
1 | 11 | 1 | 100
1 | 11 | 1 | 101
1 | 11 | 2 | 200
1 | 11 | 4 | 400
2 | 20 | 1 | 100
2 | 20 | 1 | 101
2 | 20 | 2 | 200
2 | 20 | 4 | 400
3 | 30 | 1 | 100
3 | 30 | 1 | 101
3 | 30 | 2 | 200
3 | 30 | 4 | 400
ID | V | ID | V

2. NON-EQUI JOIN ONLY (MUST BE NLJ)
ENSURE:NLJ SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID < JP_T2.ID;
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID < JP_T2.ID;
1 | 10 | 2 | 200
1 | 10 | 4 | 400
1 | 11 | 2 | 200
1 | 11 | 4 | 400
2 | 20 | 4 | 400
3 | 30 | 4 | 400
ID | V | ID | V

3. EQUI JOIN WITH DUPLICATES (RESULT CORRECTNESS)
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID = JP_T2.ID;
1 | 10 | 1 | 100
1 | 10 | 1 | 101
1 | 11 | 1 | 100
1 | 11 | 1 | 101
2 | 20 | 2 | 200
ID | V | ID | V

4. EQUI JOIN + RESIDUAL PREDICATE IN ON
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID = JP_T2.ID AND JP_T1.V < JP_T2.V;
1 | 10 | 1 | 100
1 | 10 | 1 | 101
1 | 11 | 1 | 100
1 | 11 | 1 | 101
2 | 20 | 2 | 200
ID | V | ID | V

5. EQUI JOIN + RESIDUAL PREDICATE IN WHERE
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID = JP_T2.ID WHERE JP_T1.V < JP_T2.V;
1 | 10 | 1 | 100
1 | 10 | 1 | 101
1 | 11 | 1 | 100
1 | 11 | 1 | 101
2 | 20 | 2 | 200
ID | V | ID | V

6. 3-WAY JOIN: ONE EQUI + ONE NON-EQUI (SHOULD CONTAIN BOTH JOIN TYPES)
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID = JP_T2.ID INNER JOIN JP_T3 ON JP_T1.ID < JP_T3.ID;
1 | 10 | 1 | 100 | 1 | 1000
1 | 10 | 1 | 100 | 3 | 3000
1 | 10 | 1 | 101 | 1 | 1000
1 | 10 | 1 | 101 | 3 | 3000
1 | 11 | 1 | 100 | 1 | 1000
1 | 11 | 1 | 100 | 3 | 3000
1 | 11 | 1 | 101 | 1 | 1000
1 | 11 | 1 | 101 | 3 | 3000
2 | 20 | 2 | 200 | 1 | 1000
2 | 20 | 2 | 200 | 3 | 3000
ID | V | ID | V | ID | V

7. 3-WAY JOIN: TWO EQUI JOINS
SELECT * FROM JP_T1 INNER JOIN JP_T2 ON JP_T1.ID = JP_T2.ID INNER JOIN JP_T3 ON JP_T1.ID = JP_T3.ID;
1 | 10 | 1 | 100 | 1 | 1000
1 | 10 | 1 | 100 | 3 | 3000
1 | 10 | 1 | 101 | 1 | 1000
1 | 10 | 1 | 101 | 3 | 3000
1 | 11 | 1 | 100 | 1 | 1000
1 | 11 | 1 | 100 | 3 | 3000
1 | 11 | 1 | 101 | 1 | 1000
1 | 11 | 1 | 101 | 3 | 3000
2 | 20 | 2 | 200 | 1 | 1000
2 | 20 | 2 | 200 | 3 | 3000
ID | V | ID | V | ID | V

8. JOIN WITH EMPTY TABLE
SELECT * FROM JP_T1 INNER JOIN JP_EMPTY ON JP_T1.ID = JP_EMPTY.ID;
ID | V | ID | V

9. EMPTY BUILD/PROBE SIDES (ALSO SHOULD NOT CRASH)
SELECT * FROM JP_EMPTY INNER JOIN JP_T1 ON JP_EMPTY.ID = JP_T1.ID;
ID | V | ID | V
