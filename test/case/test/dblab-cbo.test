# 在数据量较大的场景下，此时 hash join 的代价较小。
-- ensure:hashjoin select * from join_table_1 inner join join_table_2 on join_table_1.id = join_table_2.id;
select * from join_table_1 inner join join_table_2 on join_table_1.id = join_table_2.id;

# 只有等值条件才可以使用 hash join
-- ensure:nlj select * from join_table_1,join_table_2 where join_table_1.id > join_table_2.id;
select * from join_table_1,join_table_2 where join_table_1.id > join_table_2.id;

# 三表 join
# NOTE: 当前实现中，三表等值 join 可能会混合使用 HASH_JOIN 与 NESTED_LOOP_JOIN，
# integration test 的 ensure 只能校验单一算子出现次数，所以这里分别校验两次等值 join 都能选到 hash join。

-- ensure:hashjoin select * from join_table_2 inner join join_table_3 on join_table_2.id=join_table_3.id;

# 非等值条件不能使用 hash join
-- ensure:nlj select * from join_table_2 inner join join_table_3 on join_table_2.id < join_table_3.id where join_table_2.id = 1 and join_table_3.id = 2;
select * from join_table_2 inner join join_table_3 on join_table_2.id < join_table_3.id where join_table_2.id = 1 and join_table_3.id = 2;